# From Supabase Dashboard → Project Settings → API (NOT the Database connection string)
# Use the Project URL only — do not append /rest/v1
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-long-anon-key-here

# Set to false on school/corporate Wi-Fi if SSL verification fails locally
SUPABASE_SSL_VERIFY=true

# Comma-separated exact origins allowed to call this API (frontend URLs).
# Defaults to http://localhost:5173 if unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional regex to also allow dynamic origins (e.g. Vercel preview URLs).
# Leave blank to disable.
CORS_ORIGIN_REGEX=
